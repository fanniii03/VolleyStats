<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolleyStats.Views.PlayersPage"
             Title="PlayersPage"
             BackgroundColor="#1A1C23">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="12">

            <Label Text="VolleyStats"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#F4D03F"
                   Margin="0,0,0,10" />

            <Label Text="Csapatok kezelése"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#E2E8F0"
                   Margin="0,10,0,0" />

            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#2A2D39"
                    BackgroundColor="#252836"
                    Padding="15">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Új csapat létrehozása"
                           TextColor="#94A3B8"
                           FontSize="13"
                           FontAttributes="Bold" />

                    <Entry Placeholder="Csapat neve"
                           Text="{Binding NewTeamName}"
                           PlaceholderColor="#94A3B8"
                           TextColor="#E2E8F0" />

                    <Button Text="Csapat hozzáadása"
                            Command="{Binding AddTeamCommand}"
                            BackgroundColor="#F4D03F"
                            TextColor="#1A1C23"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="45" />

                    <Label Text="{Binding TeamErrorMessage}"
                           TextColor="#E06C75"
                           FontAttributes="Bold" />

                </VerticalStackLayout>
            </Border>

            <Label Text="Csapat kiválasztása" />
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#2A2D39"
                    BackgroundColor="#252836"
                    Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Csapat kiválasztása"
                           TextColor="#94a3b8"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextTransform="Uppercase" />
                    <Picker Title="Válassz csapatot"
                            TitleColor="#94A3B8"
                            TextColor="#E2E8F0"
                            ItemsSource="{Binding Teams}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedTeam}"
                            IsEnabled="{Binding IsNotEditing}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Játékosok"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#E2E8F0"
                   Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding Players}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedPlayer}"
                            HeightRequest="260"
                            IsEnabled="{Binding IsNotEditing}">

                <CollectionView.EmptyView>
                    <Label Text="Ehhez a csapathoz még nincs játékos."
                           TextColor="#94A3B8"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,6">
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    BackgroundColor="#252836"
                                    Padding="12">

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor"
                                                        Value="#313A52" />
                                                <Setter Property="Stroke"
                                                        Value="#5C9CE6" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="60,*"
                                      RowDefinitions="Auto,Auto">

                                    <Label Grid.RowSpan="2"
                                           Text="{Binding JerseyNumber}"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           TextColor="#F4D03F" />

                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#E2E8F0" />

                                    <Label Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Position}"
                                           FontSize="13"
                                           TextColor="#94A3B8" />

                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1"
                     Color="#2A2D39"
                     Margin="0,10" />

            <VerticalStackLayout Spacing="12"
                                 IsVisible="{Binding IsNotEditing}">
                <Button Text="Új játékos hozzáadása"
                        Command="{Binding NewPlayerCommand}"
                        BackgroundColor="#5C9CE6"
                        TextColor="#1A1C23"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50" />

                <Button Text="Kiválasztott játékos módosítása"
                        Command="{Binding EditPlayerCommand}"
                        BackgroundColor="#313A52"
                        TextColor="#E2E8F0"
                        CornerRadius="10"
                        HeightRequest="50" />

                <Button Text="Kiválasztott játékos törlése"
                        Command="{Binding DeletePlayerCommand}"
                        BackgroundColor="#D9534F"
                        TextColor="#FFFFFF"
                        CornerRadius="10"
                        HeightRequest="50" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12"
                                 IsVisible="{Binding IsEditing}">
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="#2A2D39"
                        Background="#252836"
                        Padding="20">
                    <VerticalStackLayout Spacing="15">

                        <Label Text="Játékos adatai"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#5C9CE6" />

                        <Entry Placeholder="Játékos neve"
                               Text="{Binding PlayerName}"
                               PlaceholderColor="#94A3B8"
                               TextColor="#E2E8F0" />

                        <Entry Placeholder="Mezszám (0–99)"
                               Keyboard="Numeric"
                               Text="{Binding JerseyNumberText}"
                               PlaceholderColor="#94A3B8"
                               TextColor="#E2E8F0" />

                        <Picker Title="Válassz posztot"
                                ItemsSource="{Binding AvailablePositions}"
                                SelectedItem="{Binding Position}"
                                TitleColor="#94A3B8"
                                TextColor="#E2E8F0" />

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#E06C75"
                               FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="15"
                              Margin="0,10,0,0">
                            <Button Grid.Column="0"
                                    Text="Mégse"
                                    Command="{Binding CancelCommand}"
                                    BackgroundColor="#313A52"
                                    TextColor="#E2E8F0"
                                    CornerRadius="10" />

                            <Button Grid.Column="1"
                                    Text="Mentés"
                                    Command="{Binding SavePlayerCommand}"
                                    BackgroundColor="#F4D03F"
                                    TextColor="#1A1C23"
                                    FontAttributes="Bold"
                                    CornerRadius="10" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>