<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="VolleyStats.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:VolleyStats.Views">
    <TabBar>
        <ShellContent Title="Meccsek" ContentTemplate="{DataTemplate views:MatchesPage}" Route="MatchesPage" />
        <ShellContent Title="Játékosok" ContentTemplate="{DataTemplate views:PlayersPage}" Route="PlayersPage" />
        <ShellContent Title="Tabella" ContentTemplate="{DataTemplate views:StandingsPage}" Route="StandingsPage" />
    </TabBar>
</Shell>
